{
  "sender_fingerprint": "northstar|federal_recycling",
  "doc_type": "contra_invoice",
  "rule_version": "v1",
  "status": "draft",
  "notes": "Single-page OCR'd invoice. Commodity (OCC) credits and HAUL FEE/Baling Wire charges share one line-item table with opposite signs, matching the pack's contra_invoice signal. Bill-to/ship-to are a two-column layout: 'FOR' on the left labels the billed party, 'SHIP TO' on the right labels the service address, both printing the same Northstar-Bimbo entity. Totals row sits tighter (16.9pt) than the body pitch (~20pt), so stop_at_subtotal keeps TOTAL out of the row group.",
  "field_selectors": [
    {
      "field": "bill_to_name",
      "anchor": "FOR",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": true
    },
    {
      "field": "invoice_number",
      "anchor": "No.",
      "region": "same-cell",
      "pattern": "account_number",
      "adjust": [
        "strip_internal_whitespace"
      ]
    },
    {
      "field": "invoice_date",
      "anchor": "DATE",
      "region": "near-anchor",
      "pattern": "date",
      "adjust": [
        "normalize_date_iso"
      ]
    },
    {
      "field": "total_printed",
      "anchor": "TOTAL",
      "anchor_alts": [
        "Total Amt.",
        "Amount Due"
      ],
      "region": "totals-block",
      "pattern": "currency"
    },
    {
      "field": "service_location",
      "anchor": "SHIP TO",
      "region": "near-anchor",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    },
    {
      "row_group": "line_items",
      "table_anchor": "DESCRIPTION",
      "column_headers": {
        "date": "DATE",
        "trans_no": "TRANS NO.",
        "reference": "REFERENCE",
        "description": "DESCRIPTION",
        "quantity": "QUANTITY",
        "unit_price": "PRICE",
        "amount": "AMOUNT"
      },
      "columns": {
        "date": "date",
        "trans_no": "account_number",
        "reference": "account_number",
        "description": "text",
        "quantity": "(\\d{1,3}\\.\\d{1,4})",
        "unit_price": "(-?\\d{1,3}\\.\\d{2})",
        "amount": "currency"
      },
      "row_count": {
        "min": 1,
        "max": 40
      },
      "allow_empty_cells": true,
      "stop_at_subtotal": true,
      "require_amount": true
    }
  ],
  "layout_fingerprint": {
    "page_count": {
      "min": 1,
      "max": 1
    },
    "has_table": true,
    "totals_page_role": "last",
    "text_source": "ocr",
    "column_signature": [
      "DATE",
      "TRANS NO.",
      "REFERENCE",
      "DESCRIPTION",
      "QUANTITY",
      "PRICE",
      "AMOUNT"
    ]
  }
}