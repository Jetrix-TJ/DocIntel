{
  "sender_fingerprint": "northstar|complete_beverage_destruction",
  "doc_type": "invoice_with_attachment",
  "rule_version": "v1",
  "status": "active",
  "notes": "One-page invoice (INVOICE #, DATE, TOTAL DUE, DUE DATE, TERMS on one label row over one value row; SEAL#/BOL# the same shape) followed by three supporting pages - a garbled OCR bill-of-lading scan and a certificate of destruction that repeats the invoice/BOL/seal numbers with no totals block. Whole document is OCR-sourced even though page 1 reads as clean text. The item table's final text line ('For destruction date... BALANCE DUE $1,177.70') sits tighter than the body row pitch and would otherwise be swallowed as a 13th row, so the row group opts into stop_at_subtotal; several rows also wrap a continuation line with no money on it, so require_amount keeps those out too.",
  "field_selectors": [
    {
      "field": "invoice_number",
      "anchor": "INVOICE #",
      "region": "near-anchor",
      "pattern": "\\d{3,10}",
      "required": true
    },
    {
      "field": "invoice_date",
      "anchor": "DATE",
      "region": "near-anchor",
      "pattern": "date",
      "adjust": ["normalize_date_iso"],
      "required": true
    },
    {
      "field": "due_date",
      "anchor": "DUE DATE",
      "region": "near-anchor",
      "pattern": "date",
      "adjust": ["normalize_date_iso"],
      "required": false
    },
    {
      "field": "total_printed",
      "anchor": "BALANCE DUE",
      "anchor_alts": ["TOTAL DUE"],
      "region": "totals-block",
      "pattern": "currency",
      "required": true
    },
    {
      "field": "bill_to_name",
      "anchor": "BILL TO",
      "region": "near-anchor",
      "pattern": "text",
      "required": true
    },
    {
      "field": "seal_number",
      "anchor": "SEAL#",
      "region": "near-anchor",
      "pattern": "account_number",
      "required": false
    },
    {
      "field": "bol_number",
      "anchor": "BOL#",
      "region": "near-anchor",
      "pattern": "account_number",
      "required": false
    },
    {
      "row_group": "line_items",
      "table_anchor": "DESCRIPTION",
      "columns": {
        "service_date": "date",
        "item_code": "text",
        "description": "text",
        "quantity": "\\s{0,5}(\\d{1,3}(?:,\\d{3})?(?:,\\d{3})?(?:\\.\\d{1,2})?)\\s{0,5}",
        "unit_price": "currency",
        "amount": "currency"
      },
      "column_headers": {
        "service_date": "SERVICE DATE",
        "item_code": "ITEM",
        "description": "DESCRIPTION",
        "quantity": "QTY",
        "unit_price": "UNIT PRICE",
        "amount": "AMOUNT"
      },
      "row_count": { "min": 1, "max": 30 },
      "allow_empty_cells": true,
      "require_amount": true,
      "stop_at_subtotal": true
    }
  ],
  "layout_fingerprint": {
    "page_count": { "min": 1, "max": 6 },
    "has_table": true,
    "totals_page_role": "first",
    "text_source": "ocr",
    "column_signature": ["SERVICE DATE", "ITEM", "DESCRIPTION", "QTY", "UNIT PRICE", "AMOUNT"]
  }
}
