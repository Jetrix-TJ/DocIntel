{
  "rule_version": "v1",
  "status": "active",
  "doc_type": "telecom_bill",
  "sender_fingerprint": "digitaldirection|lumen",
  "notes": "The only bill in the pack printing an ISO currency code, and the only one with a real invoice number. The LUMEN letterhead is an IMAGE - the token never appears in the text layer - and `INVOICE START_11755352` on line 0 is a print-stream control token that an `INVOICE\\s*(\\d+)` pattern would grab instead of the real 752233001.",
  "field_selectors": [
    {
      "field": "invoice_number",
      "anchor": "Invoice Number",
      "region": "near-anchor",
      "pattern": "([0-9]{9})"
    },
    {
      "field": "account_number",
      "anchor": "Billing Account Number",
      "region": "near-anchor",
      "pattern": "account_number"
    },
    {
      "field": "bill_date",
      "anchor": "Invoice Date",
      "region": "near-anchor",
      "pattern": "date",
      "adjust": [
        "normalize_date_iso"
      ]
    },
    {
      "field": "due_date",
      "anchor": "Payment Due",
      "region": "near-anchor",
      "pattern": "date",
      "adjust": [
        "normalize_date_iso"
      ],
      "required": false
    },
    {
      "field": "bill_to_name",
      "region": "near-anchor",
      "anchor": "Name",
      "pattern": "text"
    },
    {
      "field": "prior_balance",
      "anchor": "Previous Statement Balance",
      "region": "near-anchor",
      "pattern": "currency"
    },
    {
      "field": "payments_credits",
      "anchor": "Payment Received",
      "region": "near-anchor",
      "pattern": "currency",
      "required": false,
      "adjust": [
        "normalize_credit_sign"
      ]
    },
    {
      "field": "credits_adjustments",
      "anchor": "Credits/Adjustments",
      "region": "near-anchor",
      "pattern": "currency",
      "required": false
    },
    {
      "field": "current_charges",
      "anchor": "Current Charges",
      "region": "near-anchor",
      "pattern": "currency"
    },
    {
      "field": "total_printed",
      "anchor": "Total Amount Due",
      "region": "near-anchor",
      "pattern": "currency",
      "adjust": [
        "resolve_vendor_alias",
        "resolve_bill_to_alias"
      ]
    },
    {
      "scanline": true,
      "region": "remittance-block",
      "asserts": [
        {
          "field": "total_printed",
          "as": "digits_no_decimal"
        },
        {
          "field": "invoice_number",
          "as": "digits_only"
        }
      ]
    },
    {
      "field": "remit_payee",
      "region": "near-anchor",
      "pattern": "([A-Z][A-Za-z0-9 ,&'-]{2,45})",
      "required": false,
      "anchor": "payable to"
    },
    {
      "field": "vendor_address",
      "region": "top-left",
      "pattern": "([0-9]{1,6} .{3,60}, [A-Z]{2} [0-9]{5})",
      "required": false
    }
  ],
  "layout_fingerprint": {
    "page_count": {
      "min": 3,
      "max": 10
    },
    "has_table": true,
    "text_source": "native"
  }
}
