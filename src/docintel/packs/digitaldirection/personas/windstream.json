{
  "rule_version": "v1",
  "status": "active",
  "doc_type": "telecom_bill",
  "sender_fingerprint": "digitaldirection|windstream",
  "notes": "A three-column header/value pair: `Account number Telephone number Invoice date` on one line, the three values on the next. One anchor therefore yields three fields. The letterhead brand is broken in the text layer (`Windstre am`), so vendor_name cannot be captured exactly. No vendor_name selector: the text layer breaks the brand mid-word (`Windstre am`), so the pack's display-name table supplies it.",
  "field_selectors": [
    {
      "field": "account_number",
      "anchor": "Account number",
      "region": "near-anchor",
      "pattern": "([0-9]{9})"
    },
    {
      "field": "telephone_number",
      "anchor": "Account number",
      "region": "near-anchor",
      "pattern": "phone",
      "required": false
    },
    {
      "field": "bill_date",
      "anchor": "Invoice date",
      "region": "near-anchor",
      "pattern": "date",
      "adjust": [
        "normalize_date_iso"
      ]
    },
    {
      "field": "due_date",
      "anchor": "Due date",
      "region": "near-anchor",
      "pattern": "date",
      "adjust": [
        "normalize_date_iso"
      ],
      "required": false
    },
    {
      "field": "prior_balance",
      "anchor": "Previous Bill",
      "region": "near-anchor",
      "pattern": "currency"
    },
    {
      "field": "payments_credits",
      "anchor": "Payments/Adjustments",
      "region": "near-anchor",
      "pattern": "currency",
      "required": false,
      "adjust": [
        "normalize_credit_sign"
      ]
    },
    {
      "field": "amount_previously_due",
      "anchor": "Amount Previously Due",
      "region": "near-anchor",
      "pattern": "currency",
      "required": false
    },
    {
      "field": "current_charges",
      "anchor": "Current Charges Due",
      "region": "near-anchor",
      "pattern": "currency"
    },
    {
      "field": "total_printed",
      "anchor": "Total Amount Due",
      "region": "near-anchor",
      "pattern": "currency",
      "adjust": [
        "resolve_bill_to_alias"
      ]
    },
    {
      "field": "remit_payee",
      "anchor": "check payable to",
      "region": "near-anchor",
      "pattern": "([A-Z][A-Za-z0-9 ,&'-]{2,45})",
      "required": false,
      "adjust": [
        "resolve_vendor_alias"
      ]
    },
    {
      "scanline": true,
      "region": "remittance-block",
      "asserts": [
        {
          "field": "total_printed",
          "as": "digits_no_decimal"
        },
        {
          "field": "account_number",
          "as": "digits_only"
        }
      ]
    },
    {
      "field": "bill_to_address",
      "anchor": "CHOCTAW TRAVEL MART",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    },
    {
      "field": "remit_address",
      "anchor": "WINDSTREAM",
      "anchor_occurrence": "last",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    }
  ],
  "layout_fingerprint": {
    "page_count": {
      "min": 2,
      "max": 8
    },
    "has_table": true,
    "text_source": "native"
  }
}
