{
  "rule_version": "v1",
  "status": "active",
  "sender_fingerprint": "northstar|complete_beverage_destruction",
  "doc_type": "invoice_with_attachment",
  "notes": "OCR-only, with three handwritten Bill of Lading pages behind the invoice. Field values come only from the primary page (section 7).",
  "field_selectors": [
    {
      "field": "vendor_name",
      "region": "top-left",
      "pattern": "text"
    },
    {
      "field": "invoice_number",
      "anchor": "INVOICE #",
      "region": "near-anchor",
      "pattern": "([0-9]{5})"
    },
    {
      "field": "invoice_date",
      "anchor": "DATE",
      "region": "near-anchor",
      "pattern": "date",
      "adjust": [
        "normalize_date_iso"
      ]
    },
    {
      "field": "bill_to_name",
      "anchor": "BILL TO",
      "region": "near-anchor",
      "pattern": "text"
    },
    {
      "field": "total_printed",
      "anchor": "BALANCE DUE",
      "region": "same-row",
      "pattern": "currency",
      "adjust": [
        "resolve_vendor_alias",
        "resolve_bill_to_alias"
      ]
    },
    {
      "field": "due_date",
      "anchor": "DUE DATE",
      "region": "near-anchor",
      "pattern": "date",
      "adjust": [
        "normalize_date_iso"
      ],
      "required": false
    },
    {
      "field": "seal_number",
      "anchor": "SEAL#",
      "region": "near-anchor",
      "pattern": "([0-9]{7})",
      "required": false
    },
    {
      "field": "bol_number",
      "anchor": "BOL#",
      "region": "near-anchor",
      "pattern": "([0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{2})",
      "required": false
    },
    {
      "row_group": "line_items",
      "table_anchor": "SERVICE DATE",
      "columns": {
        "service_date": "text",
        "item_code": "text",
        "description": "text",
        "quantity": "decimal",
        "unit_price": "currency",
        "amount": "currency"
      },
      "column_headers": {
        "service_date": "SERVICE DATE",
        "item_code": "ITEM",
        "description": "DESCRIPTION",
        "quantity": "QTY",
        "unit_price": "UNIT PRICE",
        "amount": "AMOUNT"
      },
      "row_count": {
        "min": 1,
        "max": 40
      },
      "allow_empty_cells": true,
      "require_amount": true,
      "stop_at_subtotal": true
    },
    {
      "field": "vendor_address",
      "anchor": "Complete Beverage Destruction, LLC Invoice",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    }
  ],
  "layout_fingerprint": {
    "page_count": {
      "min": 1,
      "max": 6
    },
    "has_table": true,
    "text_source": "ocr"
  }
}
