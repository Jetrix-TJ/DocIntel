{
  "rule_version": "v1",
  "status": "active",
  "sender_fingerprint": "northstar|edco",
  "doc_type": "standard_invoice",
  "notes": "THE F1 TRAP. 367.96 is printed in the largest box on the page; the payable is 69.62. derive_amount_payable and resolve_carried_balance are wired on total_printed (Task 11); prior_balance_basis comes from the pack's billing-convention table via apply_billing_conventions, registered at afterExtraction.",
  "field_selectors": [
    {
      "field": "vendor_name",
      "region": "top-left",
      "pattern": "text"
    },
    {
      "field": "vendor_account_number",
      "anchor": "FOR BILLING INQUIRIES OR SERVICE,",
      "region": "any-page",
      "pattern": "744-2700 ([0-9]{2}-[0-9][A-Z] [0-9]{6})"
    },
    {
      "field": "bill_date",
      "region": "header-block",
      "pattern": "date",
      "adjust": [
        "normalize_date_iso"
      ]
    },
    {
      "field": "prior_balance",
      "anchor": "BALANCE FORWARD",
      "region": "same-row",
      "pattern": "currency",
      "required": false
    },
    {
      "field": "current_charges",
      "anchor": "CURRENT CHARGES:",
      "region": "same-row",
      "pattern": "currency",
      "required": false
    },
    {
      "field": "total_printed",
      "region": "header-block",
      "pattern": "currency",
      "adjust": [
        "resolve_vendor_alias",
        "resolve_bill_to_alias",
        "resolve_carried_balance",
        "derive_amount_payable"
      ]
    },
    {
      "field": "service_location",
      "anchor": "FOR SERVICE AT:",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    },
    {
      "scanline": true,
      "region": "page:1",
      "asserts": [
        {
          "field": "total_printed",
          "as": "digits_no_decimal"
        }
      ]
    },
    {
      "field": "vendor_address",
      "anchor": "EDCO WASTE & RECYCLING SERVICE",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    },
    {
      "field": "remit_payee",
      "region": "top-left",
      "pattern": "text",
      "required": false
    },
    {
      "field": "remit_address",
      "anchor": "EDCO WASTE & RECYCLING SERVICE",
      "anchor_occurrence": "mid_line",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    }
  ],
  "layout_fingerprint": {
    "page_count": {
      "min": 1,
      "max": 2
    },
    "has_table": true,
    "text_source": "native"
  }
}
