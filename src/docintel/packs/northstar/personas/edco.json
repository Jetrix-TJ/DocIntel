{
  "rule_version": "v1",
  "status": "active",
  "sender_fingerprint": "northstar|edco",
  "doc_type": "standard_invoice",
  "notes": "THE F1 TRAP. 367.96 is printed in the largest box on the page; the payable is 69.62. Under printed-fields-only this persona emits the printed 367.96 and says nothing about the 69.62 - the gap is downstream's to catch. prior_balance_basis WOULD come from the pack's billing-convention table rather than the page (EDCO prints no payment line at all), but apply_billing_conventions is registered at no socket, so nothing supplies it today; conventions.py is kept on disk for the wiring change that brings it back. The scanline block below is inert for the same reason: its only consumer, crosscheck_scanline, is in no adjust list.",
  "field_selectors": [
    {
      "field": "vendor_name",
      "region": "top-left",
      "pattern": "text"
    },
    {
      "field": "bill_to_name",
      "region": "any-page",
      "pattern": "(NORTHSTAR RECYCLING)"
    },
    {
      "field": "vendor_account_number",
      "anchor": "FOR BILLING INQUIRIES OR SERVICE,",
      "region": "any-page",
      "pattern": "(25-3A [0-9]{6})"
    },
    {
      "field": "bill_date",
      "region": "header-block",
      "pattern": "date",
      "adjust": [
        "normalize_date_iso"
      ]
    },
    {
      "field": "prior_balance",
      "anchor": "BALANCE FORWARD",
      "region": "same-row",
      "pattern": "currency",
      "required": false
    },
    {
      "field": "current_charges",
      "anchor": "CURRENT CHARGES:",
      "region": "same-row",
      "pattern": "currency",
      "required": false
    },
    {
      "field": "total_printed",
      "region": "header-block",
      "pattern": "currency",
      "adjust": [
        "resolve_vendor_alias"
      ]
    },
    {
      "field": "service_location",
      "anchor": "FOR SERVICE AT:",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    },
    {
      "scanline": true,
      "region": "page:1",
      "asserts": [
        {
          "field": "total_printed",
          "as": "digits_no_decimal"
        }
      ]
    },
    {
      "field": "vendor_address",
      "anchor": "EDCO WASTE & RECYCLING SERVICE",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    },
    {
      "field": "remit_payee",
      "region": "any-page",
      "pattern": "(EDCO WASTE & RECYCLING SERVICE)",
      "required": false
    },
    {
      "field": "remit_address",
      "anchor": "P.O. BOX 5488",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    },
    {
      "field": "bill_to_attention",
      "region": "any-page",
      "pattern": "(HUNTER INDUST)",
      "required": false
    }
  ],
  "layout_fingerprint": {
    "page_count": {
      "min": 1,
      "max": 2
    },
    "has_table": true,
    "text_source": "native"
  }
}
