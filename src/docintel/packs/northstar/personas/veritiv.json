{
  "rule_version": "v1",
  "status": "active",
  "sender_fingerprint": "northstar|veritiv",
  "doc_type": "standard_invoice",
  "notes": "Labels appear twice - once on the remittance stub and once in the body - so the body occurrences are reached with all_matches plus dedupe.",
  "field_selectors": [
    {
      "field": "vendor_name",
      "anchor": "VERITIV OPERATING COMPANY",
      "region": "same-row",
      "pattern": "text"
    },
    {
      "field": "invoice_number",
      "region": "header-block",
      "pattern": "(715-[0-9]{8})"
    },
    {
      "field": "invoice_date",
      "anchor": "Invoice Date",
      "region": "near-anchor",
      "pattern": "date",
      "adjust": [
        "normalize_date_iso"
      ]
    },
    {
      "field": "vendor_account_number",
      "anchor": "Account No.",
      "region": "near-anchor",
      "pattern": "(0[0-9]{5})",
      "required": false
    },
    {
      "field": "bill_to_name",
      "region": "any-page",
      "pattern": "(NORTHSTAR RECYCLING COMPANY LLC)"
    },
    {
      "field": "due_date",
      "anchor": "Due Date",
      "region": "near-anchor",
      "pattern": "date",
      "adjust": [
        "normalize_date_iso"
      ],
      "required": false
    },
    {
      "field": "total_printed",
      "anchor": "Total Amount Due",
      "region": "near-anchor",
      "pattern": "currency",
      "adjust": [
        "resolve_carried_balance",
        "derive_amount_payable",
        "crosscheck_total_composition",
        "crosscheck_line_sum",
        "crosscheck_filename",
        "infer_currency"
      ]
    },
    {
      "field": "payment_terms",
      "region": "any-page",
      "pattern": "([0-9] % [0-9]{2} DAYS, NET [0-9]{2} DAYS)",
      "required": false
    },
    {
      "row_group": "line_items",
      "table_anchor": "Product No.",
      "columns": {
        "item_code": "text",
        "amount": "currency"
      },
      "column_headers": {
        "item_code": "Product No.",
        "amount": "Extended"
      },
      "row_count": {
        "min": 1,
        "max": 40
      },
      "allow_empty_cells": true
    },
    {
      "field": "bill_to_address",
      "anchor": "NORTHSTAR RECYCLING COMPANY LLC",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    },
    {
      "field": "vendor_address",
      "anchor": "VERITIV OPERATING COMPANY",
      "region": "label-block",
      "pattern": "text_block",
      "adjust": [
        "join_lines_comma"
      ],
      "required": false
    }
  ],
  "layout_fingerprint": {
    "page_count": {
      "min": 1,
      "max": 2
    },
    "has_table": true,
    "text_source": "native"
  }
}
