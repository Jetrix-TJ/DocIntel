# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime state (regenerated; not source)
var/
*.sqlite3
*.sqlite3-journal

# Reviewer-confirmed pack overlays (docintel.webui's /review flow) - a
# per-deployment decision, not a reviewed code change; see
# packs/registry.py::load_basis_overlay.
*.local.json

# Secrets
.env

# OS
.DS_Store

# Raw sample drops (4GB+ scratch pool, not curated source) - the curated
# subset that matters lives in docs/ and docs/persona-regeneration/. No
# trailing slash: matches both a real directory and the read-only symlink
# SDD worktrees use to reach the main checkout's copy without duplicating it.
all-docs

# Local git worktrees used for isolated plan execution
.worktrees/
